{
  "name": "split-beat",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/patch-ios-audio-api.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/rhythm/*.test.ts src/audio/*.test.ts",
    "lint": "eslint .",
    "e2e:ios": "expo run:ios --configuration Release",
    "e2e:android": "expo run:android --variant release",
    "ios:archive": "SPLITBEAT_ARCHIVE_ONLY=1 bash scripts/release-testflight.sh",
    "release:testflight": "bash scripts/release-testflight.sh",
    "e2e:maestro": "node scripts/e2e/run-maestro.mjs",
    "e2e:direct-start": "E2E_MAESTRO_FLOW=direct-start.yaml node scripts/e2e/run-maestro.mjs",
    "e2e:score-import": "E2E_MAESTRO_FLOW=score-import.yaml node scripts/e2e/run-maestro.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.10",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-api": "0.13.6",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "sax": "^1.6.1",
    "vexflow": "^4.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
