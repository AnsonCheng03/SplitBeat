{
  "expo": {
    "name": "Split Beat",
    "slug": "two-hand-rhythm-trainer",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "backgroundColor": "#0B0F14",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "twohandrhythm",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "./plugins/withSplitBeatBranding",
      "./plugins/withSplitBeatHardwareKeyboard",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidPermissions": [],
          "androidForegroundService": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "icon": "./assets/icon.png",
      "backgroundColor": "#0B0F14",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.splitbeat.twohandrhythm"
    },
    "android": {
      "package": "com.splitbeat.twohandrhythm",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#0B0F14"
      },
      "permissions": []
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32941fab-0d30-4c4d-a3f6-80040afd3132"
      }
    },
    "owner": "anson12666"
  }
}
